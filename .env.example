# Chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env lên GitHub.

# ===== Khóa API model AI (chỉ cần loại bạn dùng) =====
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# DEEPSEEK_API_KEY=sk-...

# ===== Token bot Telegram (lấy từ @BotFather), tên biến khớp telegram_token_env trong agents.yaml =====
TG_TOKEN_DIEU_PHOI=123456789:AA...
TG_TOKEN_VIDEO=
TG_TOKEN_MANG_XA_HOI=
TG_TOKEN_VAN_PHONG=
TG_TOKEN_TIN_TUC=

# ===== Quyền truy cập =====
# Telegram user ID của bạn (nhắn /id cho bot để xem). Admin dùng được ngay + duyệt người khác bằng /approve
ADMIN_TELEGRAM_IDS=
# Nơi nhận báo cáo bình luận Facebook (mặc định = admin đầu tiên). Có thể là ID của group (số âm).
ADMIN_CHAT_ID=

# ===== Facebook =====
FB_GRAPH_VERSION=v23.0
# Kiểm tra bình luận mới mỗi N giây (0 = tắt). Gợi ý 120.
FB_WATCH_INTERVAL=0
# Trợ lý xử lý bình luận
FB_WATCH_AGENT=mang_xa_hoi
# true = AI tự trả lời bình luận; false = chỉ đề xuất câu trả lời cho bạn duyệt
FB_AUTO_REPLY=false

# ===== Khác =====
# Bot API server tự host để nhận file > 20MB (xem docs), ví dụ http://localhost:8081
TELEGRAM_API_BASE=
MAX_UPLOAD_MB=20
LOG_LEVEL=INFO
